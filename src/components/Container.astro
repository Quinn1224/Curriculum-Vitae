---
import * as CONTENT from "../pages/content"
import AccordionLayout from "../layouts/AccordionLayout.astro";
import Card from "./Card.astro";
---

<ul class="shadow-box">
    <AccordionLayout title={"Persönliche Daten"} icon={"carbon:user"}>
      <dl class="grid grid-cols-1 gap-x-8 gap-y-3 text-text/70 sm:grid-cols-2">
        <div>
          <dt class="text-sm text-text/50">Alter</dt>
          <dd>{CONTENT.alter}</dd>
        </div>
        <div>
          <dt class="text-sm text-text/50">Familienstand</dt>
          <dd>{CONTENT.familienstand}</dd>
        </div>
        <div>
          <dt class="text-sm text-text/50">Nationalität</dt>
          <dd>{CONTENT.nationalität}</dd>
        </div>
        <div>
          <dt class="text-sm text-text/50">Sprachen</dt>
          <dd>{CONTENT.sprache_en}</dd>
          <dd>{CONTENT.sprache_ch}</dd>
        </div>
      </dl>
    </AccordionLayout>

    <AccordionLayout title={"Beruflicher Werdegang"} icon={"ic:baseline-work-outline"}>
      {
        CONTENT.work.map((item) => {

          return (
            <Card
              title={item.role}
              timeframe={`${item.from} - ${item.to}`}
              description={item.location}
              tags={item.skills}
              url={item.org_url}
              url_name={item.org}
              last_row={item.last_row}
            />
          );
        })
      }
    </AccordionLayout>
    <AccordionLayout title={"Bildungsweg"} icon={"carbon:education"}>
      {
        CONTENT.education.map((item) => {
          return (
            <Card
              title={item.course}
              timeframe={`${item.from} - ${item.to}`}
              description={item.location}
              thesis={item.thesis}
              institute={item.institute}
              grade={item.grade}
              tags={""}
              url={item.url}
              url_name={item.institute}
              last_row={item.last_row}
            />
          );
        })
      }
    </AccordionLayout>
    <AccordionLayout title={"Freizeit Softwareprojekte"} icon={"ion:md-build"}>
      {
        CONTENT.projects.map((item) => {
          return (
            <Card
              title={item.title}
              description={item.description}
              languages={item.languages}
              tags={item.tech}
              url={item.url}
              url_name={"Github"}
              last_row={item.last_row}
            />
          );
        })
      }
    </AccordionLayout>
    <AccordionLayout title={"Weitere Hobbies"} icon={"ion:barbell"}>
      {
        CONTENT.hobbies.map((item) => {
          return (
            <Card
              title={item.title}
              description={item.description}
              tags={item.tech}
              url={item.url}
              url_name={item.institute}
              last_row={item.last_row}
            />
          );
        })
      }
    </AccordionLayout>

</ul>
