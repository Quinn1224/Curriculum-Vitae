---
import * as CONTENT from "./content"
import Container from "../components/Container.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500&display=swap" rel="stylesheet">
		<meta name='robots' content='noindex,nofollow,noarchive,nosnippet,noimageindex' />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>CV | {CONTENT.name}</title>
	</head>
	<body class="bg-background text-text flex flex-col min-h-screen">

		<Header />

		<!-- Bar Effect -->
		<article class="color-bar mx-auto h-fit max-w-3xl w-[95vw] flex flex-nowrap bg-slate-400">
				<div class="bg-slate-900 hover:scale-x-[2] w-full h-1.5" id="one"></div>
				<div class="bg-red-900 hover:scale-x-[2] w-full h-1.5" id="two"></div>
				<div class="bg-blue-900 hover:scale-x-[2] w-full h-1.5" id="three"></div>
		</article>

		<main class="mx-auto flex-grow max-w-3xl overflow-y-scroll grid gap-5 p-5 w-[95vw]">
			<Container />
		</main>
		<div class="print-controls mx-auto flex max-w-3xl justify-end px-5 pb-3 w-[95vw]">
			<button
				type="button"
				class="rounded bg-primary px-4 py-2 text-text hover:bg-primary/80"
				onclick="window.print()">
				Lebenslauf drucken
			</button>
		</div>
		<Footer />
	</body>
</html>


<style is:global>
	*{
		transition: 350ms ease-in-out;
		font-family: 'Manrope', sans-serif;
	}

	@media only screen and (max-width: 480px){
		*{
			font-size: 12px;
		}
	}

	 /* For webkit-based browsers */
	.overflow-y-scroll::-webkit-scrollbar {
		width: 3px;
	}

	.overflow-y-scroll::-webkit-scrollbar-thumb {
		background-color:#50595e;
	}

	/* For Firefox */
	.overflow-y-scroll {
		scrollbar-width: 1px;
	}

	@page {
		margin: 1.5cm;
	}

	@media print {
		body {
			display: block;
			min-height: 0;
			background: #fff !important;
			color: #111 !important;
		}

		body * {
			color: #111 !important;
			box-shadow: none !important;
			text-shadow: none !important;
		}

		.print-controls,
		.color-bar,
		footer {
			display: none !important;
		}

		header {
			padding-top: 0 !important;
			padding-bottom: 1rem !important;
		}

		header svg {
			fill: #111 !important;
		}

		main {
			display: block !important;
			width: 100% !important;
			max-width: none !important;
			overflow: visible !important;
			padding: 0 !important;
		}

		main ul {
			margin: 0 !important;
			padding: 0 !important;
		}

		main li {
			border-color: #bbb !important;
			break-inside: avoid-page;
		}

		main li > button {
			padding-left: 0 !important;
			padding-right: 0 !important;
		}

		main li > button > div > :last-child {
			display: none !important;
		}

		.accordion-content {
			max-height: none !important;
			overflow: visible !important;
		}

		.accordion-content > div {
			padding-top: 0.5rem !important;
			padding-bottom: 0.5rem !important;
		}
	}
</style>